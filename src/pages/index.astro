---
import MainLayout from '../layouts/MainLayout.astro';
import { getServices, getSiteSettings, getImageUrl, getTireBrands, getTireModels, formatPrice } from '../lib/directus.js';

// Fallback brands in case Directus is unavailable
const fallbackBrands = ['Sailun', 'Radar', 'Comforser', 'Thunderer', 'Apollo', 'Toyo', 'Dunlop', 'Bridgestone', 'MRF', 'Westlake', 'Deestone', 'Maxxis', 'Yokohama', 'Prinx', 'Goodyear', 'BFGoodrich', 'Arivo'];

// Fetch data from Directus
const siteSettings = await getSiteSettings();
const directusServices = await getServices();
const directusBrands = await getTireBrands();
const directusModels = await getTireModels();
const tireBrands = directusBrands?.map(b => b.name) || fallbackBrands;

// Fallback site settings
const settings = siteSettings || {
  business_name: 'WheelPower Tires and Auto Care Services',
  tagline: 'Your Trusted Auto Care Partner in Rizal',
  phone: '+63 9XX XXX XXXX',
  email: 'info@wheelpowerautoshop.com',
  address: 'Marilaque Highway, Baras, Rizal, Philippines',
  business_hours: '8:00 AM - 5:00 PM Daily',
  facebook_url: 'https://www.facebook.com/WheelPowerTiresAutocare',
  google_maps_url: 'https://maps.google.com/?q=WheelPower+Auto+Shop+Baras+Rizal',
};

// Use Directus services or empty array
const services = directusServices || [];

const phone = settings.phone || '09977255450';

const partners = [
  {
    name: 'Valvoline',
    logo: 'https://upload.wikimedia.org/wikipedia/commons/thumb/3/34/Valvoline_company_logo.svg/3840px-Valvoline_company_logo.svg.png',
  },
  {
    name: 'Würth',
    logo: 'https://upload.wikimedia.org/wikipedia/commons/7/7e/W%C3%BCrth_logo.svg?utm_campaign=index&utm_content=original&utm_source=commons.wikimedia.org',
  },
  {
    name: 'PowerUp',
    logo: 'https://www.powerupoil.in/automotive-grease/images/1.png',
  },
];

// Feature in-stock models with a clear starting price and available sizes.
const featuredTires = (directusModels || [])
  .map((model) => {
    const variants = (model.variants || [])
      .filter((variant) => variant.status === 'available' && variant.quantity > 0)
      .sort((a, b) => a.price - b.price);

    return {
      ...model,
      availableVariants: variants,
      fromPrice: variants[0]?.price,
    };
  })
  .filter((model) => model.availableVariants.length > 0)
  .slice(0, 4);

// Why choose us
const whyChooseUs = [
  { icon: '✓', title: 'Quality Products', description: 'We only carry trusted tire brands known for durability and performance.' },
  { icon: '✓', title: 'Expert Technicians', description: 'Our skilled team has years of experience in tire and auto care services.' },
  { icon: '✓', title: 'Fair Pricing', description: 'Competitive prices with no hidden fees. Get value for your money.' },
  { icon: '✓', title: 'Fast Service', description: 'We respect your time. Most services completed within the hour.' },
];
---

<MainLayout title="Home">
  
  <!-- Shop frontage hero -->
  <section class="relative isolate flex min-h-[82vh] items-center overflow-hidden bg-dark-950">
    <div class="absolute inset-0 -z-10">
      {settings.site_hero ? (
        <img
          src={getImageUrl(settings.site_hero)}
          alt="WheelPower Tires and Auto Care shop frontage on Marcos Highway"
          fetchpriority="high"
          class="h-full w-full object-cover object-[center_58%]"
        />
      ) : (
        <div class="h-full w-full bg-gradient-to-br from-dark-950 via-dark-900 to-dark-950"></div>
      )}
      <div class="absolute inset-0 bg-gradient-to-r from-dark-950/90 via-dark-950/65 to-dark-950/20"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-dark-950/75 via-transparent to-dark-950/10"></div>
    </div>

    <div class="relative mx-auto w-full max-w-7xl px-4 py-20 sm:px-6 md:py-28 lg:px-8">
      <div class="max-w-2xl animate-fade-in text-left">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-dark-950/55 px-4 py-2 text-sm font-medium text-dark-100 backdrop-blur-sm">
          <span aria-hidden="true" class="text-primary-400">⌖</span>
          <span>Paenaan, Baras · Marcos Highway</span>
        </div>

        <h1 class="mb-6 text-4xl font-black leading-[1.05] tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl">
          Tires, wheels<br />
          <span class="text-primary-400">and auto care.</span>
        </h1>
        <p class="mb-8 max-w-xl text-lg leading-relaxed text-dark-100 md:text-xl">
          {settings.tagline || 'Find the right tires and get dependable auto care at WheelPower, right along Marcos Highway.'}
        </p>

        <div class="mb-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium text-white">
          <span class="inline-flex items-center gap-2"><span class="text-primary-400">◷</span> Open daily, {settings.business_hours || '8 AM–5 PM'}</span>
          <a href={settings.google_maps_url || '/contact'} class="text-dark-100 underline decoration-white/40 underline-offset-4 transition-colors hover:text-primary-300">Get directions</a>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="/tires" class="btn-primary text-center text-base md:text-lg">Browse Tires <span aria-hidden="true">→</span></a>
          <a href="/book" class="btn-secondary border-white/50 bg-dark-950/30 text-center text-base text-white backdrop-blur-sm md:text-lg">Book Appointment</a>
          <a href={`tel:${phone.replace(/\s/g, '')}`} class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/40 bg-dark-950/30 px-6 py-3 font-semibold text-white backdrop-blur-sm transition-colors hover:border-primary-400 hover:text-primary-300 sm:hidden">
            <span aria-hidden="true">☎</span> Call {phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Partner showcase -->
  <section class="surface-light border-b border-dark-100 py-8 md:py-10" aria-labelledby="partners-title">
    <div class="mx-auto flex max-w-7xl flex-col items-center gap-5 px-4 sm:px-6 md:flex-row md:justify-between lg:px-8">
      <div class="text-center md:text-left">
        <p class="section-subtitle !text-primary-600">Trusted product partners</p>
        <h2 id="partners-title" class="text-xl font-bold text-dark-900">Partners with</h2>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        {partners.map((partner) => (
          <div class="flex h-16 min-w-36 items-center justify-center rounded-xl border border-dark-100 bg-white px-5 py-3 shadow-sm sm:min-w-40" title={partner.name}>
            <img src={partner.logo} alt={`${partner.name} logo`} loading="lazy" class="max-h-10 max-w-32 object-contain" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured tire inventory preview -->
  <section class="bg-dark-950 py-16 md:py-20" id="featured-tires">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="section-subtitle">Featured tire inventory</p>
          <h2 class="section-title">Find your next set</h2>
          <p class="mt-3 max-w-2xl text-dark-300">Browse tire models, sizes, and starting prices from our shop inventory.</p>
        </div>
        <a href="/tires" class="font-semibold text-primary-400 transition-colors hover:text-primary-300">View all tires <span aria-hidden="true">→</span></a>
      </div>

      {featuredTires.length > 0 ? (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {featuredTires.map((model) => {
            const brandName = typeof model.brand === 'object' ? model.brand?.name : model.brand;
            const startingVariant = model.availableVariants[0];
            return (
              <a href={`/tires/${model.slug}`} class="group overflow-hidden rounded-2xl border border-dark-800 bg-dark-900 transition-all hover:-translate-y-1 hover:border-primary-500/50 hover:shadow-xl hover:shadow-black/20">
                <div class="aspect-[4/3] overflow-hidden bg-white p-5">
                  {model.image ? (
                    <img src={getImageUrl(model.image)} alt={`${brandName || ''} ${model.name}`} loading="lazy" class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105" />
                  ) : (
                    <div class="flex h-full items-center justify-center text-6xl text-dark-200" aria-hidden="true">◉</div>
                  )}
                </div>
                <div class="p-5">
                  <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-primary-400">{brandName || 'WheelPower'}</p>
                  <h3 class="text-lg font-bold text-white transition-colors group-hover:text-primary-300">{model.name}</h3>
                  <p class="mt-2 text-sm text-dark-300">{model.availableVariants.length} available {model.availableVariants.length === 1 ? 'size' : 'sizes'} · starting at</p>
                  <div class="mt-1 flex items-center justify-between gap-3">
                    <span class="text-xl font-bold text-white">{formatPrice(model.fromPrice)}</span>
                    <span class="text-sm font-semibold text-primary-400">Details →</span>
                  </div>
                  <p class="mt-3 border-t border-dark-800 pt-3 text-xs text-dark-400">Popular size: {startingVariant.size}</p>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="rounded-2xl border border-dark-800 bg-dark-900 p-8 text-center">
          <p class="text-dark-300">Check our full tire inventory or call us for current availability.</p>
          <a href="/tires" class="btn-primary mt-5">Browse Tires</a>
        </div>
      )}
    </div>
  </section>

  <!-- Services Section -->
  <section class="py-20 surface-light" id="services">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section header -->
      <div class="text-center mb-12">
        <p class="section-subtitle">Our Services</p>
        <h2 class="section-title">What We Offer</h2>
        <p class="text-dark-400 mt-4 max-w-2xl mx-auto">
          From tire installation to complete auto maintenance, we've got your vehicle covered.
        </p>
      </div>
      
      <!-- Services grid -->
      {services.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {services.slice(0, 6).map((service) => (
            <a href={`/services#${service.id || service.name?.toLowerCase().replace(/\s+/g, '-')}`} class="card p-6 group cursor-pointer">
              <div class="text-4xl mb-4">{service.icon || '🔧'}</div>
              <h3 class="text-xl font-bold text-white mb-2 group-hover:text-primary-400 transition-colors">
                {service.name}
              </h3>
              <p class="text-dark-400 text-sm leading-relaxed">
                {service.short_description}
              </p>
              <div class="mt-4 text-primary-400 text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity">
                Learn more →
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-dark-400 mb-4">Services coming soon!</p>
          <a href="/contact" class="btn-primary">Contact Us for Services</a>
        </div>
      )}
      
      <!-- View all link -->
      {services.length > 0 && (
        <div class="text-center mt-10">
          <a href="/services" class="text-primary-400 font-semibold hover:text-primary-300 transition-colors">
            View All Services →
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- Tire Brands Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subtitle">Tire Brands</p>
        <h2 class="section-title">Premium Brands We Carry</h2>
        <p class="text-dark-400 mt-4 max-w-2xl mx-auto">
          Explore tire brands and models currently available at WheelPower, with options for different vehicles and budgets.
        </p>
      </div>
      
      <div class="flex flex-wrap justify-center gap-4">
        {tireBrands.map((brand) => (
          <a 
            href={`/tires?brand=${brand.toLowerCase()}`}
            class="px-8 py-4 bg-white rounded-xl border border-dark-100 hover:border-primary-500/50 hover:shadow-md transition-all cursor-pointer group"
          >
            <span class="font-bold text-lg text-dark-900 group-hover:text-primary-600 transition-colors">{brand}</span>
          </a>
        ))}
      </div>
      
      <div class="text-center mt-10">
        <a href="/tires" class="btn-primary">
          Browse All Tires
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Us Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left content -->
        <div>
          <p class="section-subtitle">Why Choose Us</p>
          <h2 class="section-title mb-6">Your Trusted Auto Care Partner</h2>
          <p class="text-dark-300 mb-8 leading-relaxed">
            {settings.about_text ? (
              <span set:html={settings.about_text} />
            ) : (
              `At ${settings.business_name || 'WheelPower'}, we're more than just a tire shop. We're your partners in keeping your vehicle safe and road-ready. Located along Marilaque Highway in Baras, Rizal, we've built our reputation on quality service and customer satisfaction.`
            )}
          </p>
          
          <div class="space-y-4">
            {whyChooseUs.map((item) => (
              <div class="flex gap-4">
                <div class="w-8 h-8 bg-primary-500/20 rounded-full flex items-center justify-center flex-shrink-0">
                  <span class="text-primary-400 font-bold">{item.icon}</span>
                </div>
                <div>
                  <h4 class="font-semibold text-white">{item.title}</h4>
                  <p class="text-dark-400 text-sm">{item.description}</p>
                </div>
              </div>
            ))}
          </div>
          
          <div class="mt-8">
            <a href="/contact" class="btn-secondary">
              Learn More About Us
            </a>
          </div>
        </div>
        
        <!-- Shop frontage -->
        <div class="relative">
          <div class="relative aspect-[4/3] overflow-hidden rounded-2xl border border-dark-700/50 bg-dark-900 shadow-2xl shadow-black/20">
            {settings.site_hero ? (
              <img src={getImageUrl(settings.site_hero)} alt="WheelPower shop frontage on Marcos Highway" loading="lazy" class="h-full w-full object-cover object-[center_58%]" />
            ) : (
              <div class="flex h-full items-center justify-center bg-gradient-to-br from-dark-800 to-dark-950 text-6xl" aria-hidden="true">🏪</div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-dark-950/90 via-transparent to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7">
              <p class="text-sm font-semibold uppercase tracking-wider text-primary-300">Find us on Marcos Highway</p>
              <p class="mt-1 text-lg font-bold text-white">{settings.address || 'Paenaan, Baras, Rizal'}</p>
              <a href={settings.google_maps_url || '/contact'} class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-white underline decoration-white/40 underline-offset-4 hover:text-primary-300">
                Get directions <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-gradient-to-r from-primary-600 to-primary-500 relative overflow-hidden">
    <!-- Background pattern -->
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 30px 30px;"></div>
    
    <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Ready to Get Started?
      </h2>
      <p class="text-primary-100 text-lg mb-8 max-w-2xl mx-auto">
        Book your appointment today or visit us at {settings.address || 'Marilaque Highway, Baras, Rizal'}. 
        We're open {settings.business_hours || '8:00 AM to 5:00 PM daily'}.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/book" class="bg-dark-950 text-white font-bold px-8 py-4 rounded-xl hover:bg-dark-800 transition-colors">
          📅 Book Appointment
        </a>
        <a href={`tel:${settings.phone?.replace(/\s/g, '') || '+639XXXXXXXXX'}`} class="bg-transparent border border-white/70 text-white font-bold px-8 py-4 rounded-xl hover:bg-white/10 transition-colors flex items-center justify-center gap-2">
          <span>📞</span>
          <span>Call Now</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Location Section -->
  <section class="py-20 surface-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <p class="section-subtitle">Find Us</p>
        <h2 class="section-title">Our Location</h2>
        <p class="text-dark-400 mt-4">
          {settings.address || 'Conveniently located along Marilaque Highway, Baras, Rizal'}
        </p>
      </div>
      
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Map -->
        <div class="lg:col-span-2 aspect-video bg-dark-800 rounded-2xl overflow-hidden border border-dark-700/50">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3860.5587037092796!2d121.25666469999999!3d14.624196999999999!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3397bfae47f60a23%3A0x5d48741dbede8468!2sWheelpower%20Tires%20and%20Auto%20Care%20Services!5e0!3m2!1sen!2sph!4v1768054842706!5m2!1sen!2sph"
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="WheelPower Auto Shop Location"
            class="grayscale hover:grayscale-0 transition-all duration-500"
          ></iframe>
        </div>
        
        <!-- Contact Info Card -->
        <div class="card p-8">
          <h3 class="text-xl font-bold text-white mb-6">Visit Us</h3>
          
          <div class="space-y-6">
            <div>
              <h4 class="text-primary-400 font-medium mb-2">📍 Address</h4>
              <p class="text-dark-300">
                {settings.address || 'Marilaque Highway, Baras, Rizal, Philippines'}
              </p>
            </div>
            
            <div>
              <h4 class="text-primary-400 font-medium mb-2">🕐 Business Hours</h4>
              <p class="text-dark-300">
                Monday - Sunday<br />
                <span class="font-semibold text-white">{settings.business_hours || '8:00 AM - 5:00 PM'}</span>
              </p>
            </div>
            
            <div>
              <h4 class="text-primary-400 font-medium mb-2">📞 Phone</h4>
              <a href={`tel:${settings.phone?.replace(/\s/g, '') || '+639XXXXXXXXX'}`} class="text-dark-300 hover:text-primary-400 transition-colors">
                {settings.phone || '+63 9XX XXX XXXX'}
              </a>
            </div>
            
            <a 
              href={settings.google_maps_url || 'https://maps.google.com/?q=WheelPower+Auto+Shop+Baras+Rizal'}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary w-full text-center block"
            >
              Get Directions
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</MainLayout>
